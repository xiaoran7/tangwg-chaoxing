# ---- 上游 CPA（OpenAI 兼容）----
# 注意 base_url 已含 /v1，下面会自动拼 /chat/completions
CPA_BASE_URL=https://你的CPA地址/v1
CPA_API_KEY=sk-你的密钥
# 默认模型：脚本面板没选模型（或选「服务端默认」）时用它。
CPA_MODEL=gpt-4o-mini
# 可选：允许脚本面板切换到的模型白名单（逗号分隔）。
# 留空 = 不限制，面板拉到什么就能选什么；填了就只认列表内的值，手改请求也打不进来。
# 例：CPA_MODEL_ALLOWLIST=gemini-3.8-flash-high,gpt-4o-mini
CPA_MODEL_ALLOWLIST=
# 上游 /v1/models 列表缓存的秒数。面板打开/点「刷新」时会带 refresh=1 强制回源。
MODEL_LIST_TTL=300

# ---- 上游调用方式 ----
# 流式开关。CPA 的 antigravity 非流式路径(operation=generate)实测比流式(operation=generate_stream)
# 慢约 34%，尾延迟也更容易撞到超时顶；流式还能吃到 CPA 的 `: keep-alive` SSE 保活帧。
CPA_STREAM=true
# 单次 socket 读超时，必须大于 CPA 的 streaming.keepalive-seconds(15s)，
# 放宽到 60s 以兼容不推保活帧的长思考上游。
CPA_READ_TIMEOUT=60

# 思考强度透传（CPA / Gemini 等支持 reasoning_effort 的模型建议开启）：
# 普通双路默认 low（设为 auto 时模型名含 flash 自动切 high；其余维持默认）；
# 分歧时第 3 路仲裁默认 medium；直连不支持该字段的非思考模型时可留空（不传）。
CPA_REASONING_EFFORT=low
CPA_ARBITRATE_REASONING_EFFORT=medium

# ---- 时序预算 ----
# 客户端硬编码 timeout=240s（听力 360s）。服务端总预算必须小于它，
# 否则服务端还在跑、客户端先放弃，nginx 侧就会记 499。
CPA_TIMEOUT=210                 # 单次尝试墙钟预算（外层 asyncio.wait_for 硬截断）
CPA_AUDIO_TIMEOUT=330           # 听力单次尝试墙钟预算
CPA_TOTAL_BUDGET=210            # 整次搜题的总墙钟预算（双路并行 + 第三路仲裁共享）
CPA_AUDIO_TOTAL_BUDGET=330      # 听力题的总墙钟预算
CPA_PAIR_GRACE=60               # 双路并行时，首路拿到有效答案后最多再等副路多少秒
CPA_AUDIO_PAIR_GRACE=90         # 听力题双路协同宽限(秒)
CPA_MIN_ARBITRATE_BUDGET=20     # 剩余预算低于该值时跳过第三路仲裁，直接回退单路答案
CPA_RETRIES=1                   # 只在"快速失败"时才会真的重试，慢失败不重试

# ---- 本地缓存 ----
CACHE_PATH=/var/lib/tiku-proxy/answers.db
CACHE_TTL=2592000

# ---- 客户端鉴权（留空表示不校验）----
# 建议填：脚本设置面板里「密钥」输入框填同一个值
PROXY_TOKEN=

# ---- 可选：服务端 STT 语音转文字（全部留空，不硬编码）----
# 脚本面板把「听力音频」切到「STT 转文字」且未在面板自填 STT 端点时，代理层用这里：
# 支持两类 HTTP 接口（按地址自动识别，不支持 ws/wss 实时流式）：
#   1) OpenAI 兼容：https://api.siliconflow.cn/v1 或 https://api.groq.com/openai/v1
#   2) Deepgram REST：https://api.deepgram.com/v1/listen（模型如 nova-3）
STT_BASE_URL=
STT_API_KEY=
STT_MODEL=
STT_TIMEOUT=120
# 未收到脚本指定时的默认音频策略：llm（大模型直听 input_audio）| stt（先转文字再给纯文本模型）
DEFAULT_AUDIO_MODE=llm
